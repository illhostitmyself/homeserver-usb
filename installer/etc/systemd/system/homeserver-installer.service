[Unit]
Description=Home Server installer
ConditionKernelCommandLine=boot=live
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
User=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM=wayland QT_SCALE_FACTOR=1.25
ExecStart=/usr/bin/cage -d -s -- /usr/bin/calamares
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
