[Unit]
Description=Home Server installer
ConditionKernelCommandLine=boot=live
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
User=root
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM=wayland
ExecStartPre=/usr/lib/homeserver/list-drives.sh
ExecStart=/usr/bin/cage -d -s -- /usr/lib/homeserver/installer-scale.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
