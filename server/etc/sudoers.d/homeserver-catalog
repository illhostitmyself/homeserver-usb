# Lets the "Home Server apps" page in Cockpit install a new app catalog, add or remove apps from it,
# change how the dashboard looks and connect Tailscale, without administrative access. Only catalog
# releases signed with the Home Server key are used.
%sudo ALL=(root) NOPASSWD: /usr/lib/homeserver/catalog.sh update, /usr/lib/homeserver/catalog.sh apps, \
  /usr/lib/homeserver/catalog.sh look, /usr/lib/homeserver/catalog.sh remote status, \
  /usr/lib/homeserver/catalog.sh remote logout
