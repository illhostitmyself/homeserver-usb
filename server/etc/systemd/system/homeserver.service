[Unit]
Description=Home Server apps
ConditionKernelCommandLine=!boot=live
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target homeserver-firstboot.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/homeserver/homeserver.env
EnvironmentFile=/etc/homeserver/compose.env
EnvironmentFile=/etc/homeserver/secrets.env
Environment=SRV=/srv
ExecStart=/usr/bin/docker compose -f /usr/lib/homeserver/compose.yaml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /usr/lib/homeserver/compose.yaml stop

[Install]
WantedBy=multi-user.target
