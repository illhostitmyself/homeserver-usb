[Unit]
Description=Home Server app update (download newer app versions after an update from the USB stick)
ConditionKernelCommandLine=!boot=live
ConditionPathExists=/var/lib/homeserver/refresh-images
Wants=network-online.target
After=network-online.target docker.service homeserver-firstboot.service
Requires=docker.service
Before=homeserver.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/homeserver/homeserver.env
EnvironmentFile=/etc/homeserver/compose.env
EnvironmentFile=/etc/homeserver/secrets.env
Environment=SRV=/srv
ExecStart=/usr/bin/docker compose -f /usr/lib/homeserver/compose.yaml pull --quiet
ExecStartPost=/usr/bin/rm -f /var/lib/homeserver/refresh-images
TimeoutStartSec=1h

[Install]
WantedBy=multi-user.target
