[Unit]
Description=Home Server screen
ConditionKernelCommandLine=!boot=live
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland MOZ_ENABLE_WAYLAND=1
ExecStart=/usr/bin/cage -d -s -- /usr/bin/firefox-esr file:///usr/share/homeserver/starting.html
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
