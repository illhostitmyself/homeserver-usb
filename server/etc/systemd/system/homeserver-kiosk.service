[Unit]
Description=Home Server screen
ConditionKernelCommandLine=!boot=live
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
# Firefox comes straight back if it is closed or crashes; the screen never drops to a console.
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland MOZ_ENABLE_WAYLAND=1
# %H is this computer's name: the screen opens the dashboard as <name>.local, like other devices.
ExecStart=/usr/bin/cage -d -s -- /usr/bin/firefox-esr "file:///usr/share/homeserver/starting.html?host=%H"
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
