[Unit]
Description=Home Server app setup (retry after a failed install-time setup)
ConditionKernelCommandLine=!boot=live
ConditionPathExists=!/var/lib/homeserver/setup-done
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
Before=homeserver.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/var/lib/homeserver/catalog/configure-apps.sh /
TimeoutStartSec=1h

[Install]
WantedBy=multi-user.target
